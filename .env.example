# Database
DATABASE_URL=postgresql://bridge:bridge@localhost:5432/bridge
POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge
POSTGRES_DB=bridge

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Direct API (local default). Production same-host: https://your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000
# When NEXT_PUBLIC_API_URL uses /api on the web host, proxy to FastAPI (web middleware)
# API_PROXY_TARGET=http://api:8000
JWT_SECRET=change-me-shared-with-api

# FastAPI
API_JWT_SECRET=change-me-shared-with-api
CORS_ORIGINS=http://localhost:3000

# Phase timing (local dev: use minutes < 1440 for a short Know week, or skip the timer via Know [Dev] button)
PHASE2_DURATION_DAYS=7
PHASE2_DURATION_MINUTES=5
MATCHING_LEAD_FRACTION=0.1
# Pair the first two summary-ready users (FIFO)
MATCHING_SIMPLE_FIRST_PAIR=true

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# LiveKit (local: docker compose up livekit — or use LiveKit Cloud wss URL)
LIVEKIT_URL=ws://localhost:7880
# Browser-facing URL when API runs in Docker (defaults to LIVEKIT_URL)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
BRIDGE_AGENT_INTERNAL_KEY=dev-agent-key
WINGMAN_AGENT_NAME=bridge-wingman

# LLM (matching)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MATCHING_LLM_PROVIDER=openai

# Email (magic link - dev uses console)
EMAIL_FROM=noreply@bridge.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
